[
 {
  "line": 1,
  "text": "عشان يهرب من تهمة الخيانة العظمى والتعاون مع النازيين",
  "start": 0.02,
  "end": 3.1
 },
 {
  "line": 2,
  "text": "هان فان ميجرين ما لقاش قدامه غير حل واحد",
  "start": 3.46,
  "end": 6.12
 },
 {
  "line": 3,
  "text": "إنه يعترف إنه نصاب",
  "start": 6.62,
  "end": 7.78
 },
 {
  "line": 4,
  "text": "سنة 1945 السلطات الهولندية قبضت على هان",
  "start": 8.63,
  "end": 12.31
 },
 {
  "line": 5,
  "text": "بعد ما لقوا لوحة نادرة للفنان الشهير فيرمير",
  "start": 12.64,
  "end": 15.17
 },
 {
  "line": 6,
  "text": "في حوزة هيرمان جورينج",
  "start": 15.6,
  "end": 17.01
 },
 {
  "line": 7,
  "text": "واحد من أكبر قادة النازيين",
  "start": 17.42,
  "end": 19.22
 },
 {
  "line": 8,
  "text": "التهمة كانت واضحة",
  "start": 19.94,
  "end": 20.83
 },
 {
  "line": 9,
  "text": "بيع كنز من تراث البلد للعدو",
  "start": 21.12,
  "end": 22.79
 },
 {
  "line": 10,
  "text": "وعقوبتها الإعدام",
  "start": 23.02,
  "end": 24.0
 },
 {
  "line": 11,
  "text": "لكن هان فجر مفاجأة قدام المحققين",
  "start": 24.78,
  "end": 27.26
 },
 {
  "line": 12,
  "text": "اللوحة دي مش أصلية",
  "start": 27.82,
  "end": 28.69
 },
 {
  "line": 13,
  "text": "أنا اللي راسمها بإيدي",
  "start": 29.26,
  "end": 30.27
 },
 {
  "line": 14,
  "text": "المشكلة إن ما فيش حد صدقه",
  "start": 30.96,
  "end": 32.51
 },
 {
  "line": 15,
  "text": "اللوحات كانت مخدعة كبار الخبراء",
  "start": 33.05,
  "end": 34.79
 },
 {
  "line": 16,
  "text": "لدرجة إنهم اعتبروها أصلية 100%",
  "start": 35.17,
  "end": 37.66
 },
 {
  "line": 17,
  "text": "تخيل توصل لمرحلة من الإتقان في الكدب",
  "start": 38.29,
  "end": 40.64
 },
 {
  "line": 18,
  "text": "لدرجة إنك لما تقول الحقيقة ما حدش يصدقك",
  "start": 41.06,
  "end": 43.54
 },
 {
  "line": 19,
  "text": "عشان يثبت كلامه هان اضطر يمسك الفرشة تاني",
  "start": 44.34,
  "end": 46.85
 },
 {
  "line": 20,
  "text": "تحت رقابة صارمة",
  "start": 47.42,
  "end": 48.3
 },
 {
  "line": 21,
  "text": "قعد شهور يرسم لوحة جديدة",
  "start": 48.61,
  "end": 50.23
 },
 {
  "line": 22,
  "text": "بنفس أسلوب فيرمير القديم",
  "start": 50.56,
  "end": 51.9
 },
 {
  "line": 23,
  "text": "وفي نفس الوقت",
  "start": 52.44,
  "end": 52.97
 },
 {
  "line": 24,
  "text": "التحليلات العلمية للوحاته القديمة",
  "start": 53.54,
  "end": 55.42
 },
 {
  "line": 25,
  "text": "كشفت عن مواد كيميائية",
  "start": 55.82,
  "end": 57.22
 },
 {
  "line": 26,
  "text": "ما كانتش موجودة أصلاً في عصر فيرمير",
  "start": 57.22,
  "end": 59.33
 },
 {
  "line": 27,
  "text": "فعلاً تهمة الخيانة اتشالت",
  "start": 60.11,
  "end": 61.61
 },
 {
  "line": 28,
  "text": "لكن هان ما خرجش بريء",
  "start": 62.02,
  "end": 63.55
 },
 {
  "line": 29,
  "text": "سنة 1947 صدر حكم بسجنه سنة كاملة",
  "start": 64.1,
  "end": 67.79
 },
 {
  "line": 30,
  "text": "بتهمة التزوير والاحتيال",
  "start": 68.03,
  "end": 69.53
 },
 {
  "line": 31,
  "text": "خرج من التهمة الأخطر",
  "start": 70.37,
  "end": 71.5
 },
 {
  "line": 32,
  "text": "لما أثبت للكل إنه فعلاً مجرم",
  "start": 71.89,
  "end": 74.13
 },
 {
  "line": 33,
  "text": "بس من نوع تاني خالص",
  "start": 74.77,
  "end": 75.9
 }
]