 "voice": {
  "file": "voice/vo_trimmed.wav",
  "words": "voice/words.json",
  "lines": [
   {
    "who": null,
    "text": "If you ever find yourself in the backrooms, never answer a voice you recognize."
   },
   {
    "who": null,
    "text": "Six wanderers have been lost on level zero for nine days when they hear a woman down the hallway."
   },
   {
    "who": null,
    "text": "Over here, I found the way out."
   },
   {
    "who": null,
    "text": "Everyone starts running, except Maya."
   },
   {
    "who": null,
    "text": "She grabs the nearest guy by the collar."
   },
   {
    "who": "maya",
    "text": "Don't, that's Lena."
   },
   {
    "who": null,
    "text": "And he goes,"
   },
   {
    "who": "cal",
    "text": "great, so she's alive."
   },
   {
    "who": null,
    "text": "But Lena went missing on day two."
   },
   {
    "who": null,
    "text": "You see, the things down here copy voices, but only voices they've heard screaming."
   },
   {
    "who": null,
    "text": "So everyone freezes, and for a second it's dead quiet."
   },
   {
    "who": null,
    "text": "Then the voice calls again, closer."
   },
   {
    "who": null,
    "text": "And this time it sounds exactly like Maya, who is still holding his collar and hasn't blinked once."
   }
  ]
 },
